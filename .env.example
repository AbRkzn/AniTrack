# Supabase project credentials (Expo reads env vars prefixed with EXPO_PUBLIC_)
# 1. Create a free project at https://supabase.com
# 2. Open Project Settings > API and copy the Project URL and anon public key
# 3. Paste them below (no quotes) and run the SQL in supabase/schema.sql
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
